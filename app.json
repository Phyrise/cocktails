{
  "expo": {
    "name": "Arturo et Clémentine",
    "slug": "arturo-et-clementine",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arturoclementine",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.arturoetclementine.cocktails",
      "adaptiveIcon": {
        "backgroundColor": "#501221",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "name": "Arturo et Clémentine",
      "shortName": "A&C Cocktails",
      "lang": "fr",
      "description": "Quoi boire ce soir ? Recettes de cocktails, votre bar et vos envies.",
      "themeColor": "#8C2638",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#501221",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Arturo et Clémentine à choisir une photo pour une recette expérimentale."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad9f729e-42ab-4da5-8208-6a91e0c64a3d"
      }
    }
  }
}
